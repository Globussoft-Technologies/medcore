# Local secrets folder — somewhere to keep raw Firebase service-account JSONs
# and other downloaded credentials on disk. NEVER commit. (The app reads the
# service account from FIREBASE_ADMIN_CREDENTIALS_JSON inline, not from a file,
# but this folder stays ignored so a stray downloaded key can't be committed.)
# If you delete this rule by accident, every file inside becomes git-trackable
# on the next `git add .` — extremely bad for private keys.
secrets/
**/secrets/
deploy.py
deploy_*.py
debug_*.py
*_debug.png
*.log
coverage/
uploads/
*.bak
.DS_Store
Thumbs.db
backups/*.sql.gz
# Catch ad-hoc DB dumps left at the repo root (see ops incident 2026-04-22 where
# a ~2MB root-owned medcore_software_db-22042026.sql sat in the prod working tree).
/medcore_software_db-*.sql
/*.sql.gz
# Ignore everything inside .claude/ EXCEPT skills/ and settings.json
# (the project-shared files) — git can't unignore children of an
# ignored parent, so we glob the contents (.claude/* / .claude/**)
# then re-include the project-shared bits. settings.local.json stays
# local-only (per-user permissions / overrides).
.claude/*
.claude/**/
!.claude/skills/
!.claude/skills/**
!.claude/settings.json
*.tsbuildinfo
playwright-report/
test-results/
diag_*.py
run_*.py
verify_cron*.py
PRD.md
MedCore_AI_Features_PRD.md
MedCore_AI_Features_PRD.pdf
MedCore_AI_Features_PRD.pdf.txt
AI_GAP_ANALYSIS.md
.deploy-log.txt
.test-local/

# Manual backups + stray Firebase config that accumulate on the dev-server
# checkout during debugging and otherwise dirty the tree for the next deploy.
*_bkp
env_bkp
firebase.json
apps/api/firebase.json

