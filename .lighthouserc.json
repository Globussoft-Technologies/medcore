{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/patient",
        "http://localhost:3000/patient/dashboard",
        "http://localhost:3000/patient/bills",
        "http://localhost:3000/patient/appointments"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "emulatedFormFactor": "mobile"
      }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "uses-http2": "off",
        "csp-xss": "off",
        "is-on-https": "off",
        "errors-in-console": "warn",
        "cls-culprits-insight": "warn",
        "image-delivery-insight": "warn",
        "label-content-name-mismatch": "warn",
        "legacy-javascript-insight": "warn",
        "network-dependency-tree-insight": "warn",
        "skip-link": "warn",
        "unused-javascript": "warn",
        "render-blocking-insight": "warn",
        "render-blocking-resources": "warn",
        "uses-long-cache-ttl": "warn",
        "uses-rel-preconnect": "warn",
        "unminified-javascript": "warn",
        "lcp-discovery-insight": "warn",
        "lcp-phases-insight": "warn",
        "font-display-insight": "warn",
        "font-display": "warn",
        "image-delivery-insight": "warn",
        "third-parties-insight": "warn",
        "viewport-insight": "warn",
        "dom-size-insight": "warn",
        "cls-culprits-insight": "warn",
        "forced-reflow-insight": "warn",
        "slow-css-rule-insight": "warn",
        "modern-image-formats-insight": "warn",
        "interaction-to-next-paint-insight": "warn",
        "duplicated-javascript-insight": "warn",
        "documentlatency-insight": "warn",
        "document-latency-insight": "warn",
        "cache-insight": "warn",
        "uses-text-compression": "warn",
        "uses-optimized-images": "warn",
        "modern-image-formats": "warn",
        "efficient-animated-content": "warn",
        "duplicated-javascript": "warn",
        "preload-lcp-image": "warn",
        "prioritize-lcp-image": "warn",
        "preload-fonts": "warn",
        "third-party-summary": "warn",
        "third-party-facades": "warn",
        "non-composited-animations": "warn",
        "bf-cache": "warn",
        "uses-passive-event-listeners": "warn",
        "uses-responsive-images": "warn",
        "offscreen-images": "warn",
        "total-byte-weight": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
