{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/patient",
        "http://localhost:3000/patient/dashboard",
        "http://localhost:3000/patient/bills",
        "http://localhost:3000/patient/appointments"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "emulatedFormFactor": "mobile"
      }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "uses-http2": "off",
        "csp-xss": "off",
        "is-on-https": "off",
        "errors-in-console": "warn",
        "cls-culprits-insight": "warn",
        "image-delivery-insight": "warn",
        "label-content-name-mismatch": "warn",
        "legacy-javascript-insight": "warn",
        "network-dependency-tree-insight": "warn",
        "skip-link": "warn",
        "unused-javascript": "warn",
        "render-blocking-insight": "warn",
        "render-blocking-resources": "warn",
        "uses-long-cache-ttl": "warn",
        "uses-rel-preconnect": "warn",
        "unminified-javascript": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
