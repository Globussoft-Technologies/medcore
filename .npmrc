# Legacy peer-deps resolution.
#
# Reason: apps/mobile pulls react-native@0.85, which peers react@^19, while
# the workspace pins react@^18.3 (web + api expect 18 — React 19 upgrade is
# tracked in PRs #471 + #467, blocked on a coordinated migration). The
# existing root lockfile encodes a working tree that was created before
# npm started enforcing strict peer-deps, so `npm install` on an existing
# lockfile silently accepts it. Dependabot — which regenerates the lockfile
# from scratch — trips on the conflict and every bot PR fails ERESOLVE
# during the install step.
#
# Setting `legacy-peer-deps=true` makes `npm install` permissive about peer
# conflicts in both the lockfile-present and lockfile-regenerate paths, so
# CI behaves identically across direct pushes and dependabot PRs.
#
# Remove this flag when react-native@0.85 + react@19 land together
# (#471 + #467 must merge as a pair).
legacy-peer-deps=true
