  // list. One-tap insertion of a doctor's frequently-prescribed medicines
  // into the Rx writer. Coexists with PrescriptionTemplate (whole-Rx
  // scaffold); this is per-medicine.
  favouriteMedicines DoctorFavouriteMedicine[]

  // Pearl §4.1 (gap row 101) — default commission % when this doctor is
