// ─── BILLING ────────────────────────────────────────────

model Invoice {
  id               String        @id @default(uuid())
  invoiceNumber    String        @unique
  // Invoice was historically appointment-scoped (one-to-one with Appointment).
  // 2026-05-25: IPD invoices need their own anchor — Admissions don't have an
  // Appointment row. Made `appointmentId` nullable and added `admissionId`
  // (also nullable, also @unique) so an Invoice belongs to EXACTLY one of
  // {Appointment, Admission}. The "exactly one" invariant is enforced at the
  // route layer (billing.ts and admissions.ts) — Prisma can't express XOR
  // constraints natively. Nullable @unique columns allow multiple NULLs in
  // both PostgreSQL and SQLite, so a single Invoice continues to map 1:1 to
  // its parent without false-positive uniqueness violations.
  appointmentId    String?       @unique
  admissionId      String?       @unique
  // Standalone PHARMACY bill anchor (2026-06): the Pharmacy Kanban "Generate
  // Bill" creates a pharmacy-only invoice (dispensed medicines ONLY — no
  // consultation/other lines) linked to its prescription. Nullable scalar (no
  // FK relation needed); indexed for lookup. One-bill-per-prescription is
  // enforced in app code (find-or-create checks for an existing row first) —
  // NOT a DB UNIQUE, which the migration-safety gate flags as a UNIQUE_ADDITION
  // even on a brand-new all-NULL column. Appointment/admission stay null here.
  prescriptionId   String?
  patientId        String
  // Issue #901 (2026-05-19): money columns migrated from Float (IEEE-754
  // double) to DECIMAL(12,2) so paise arithmetic is exact and reconciles
  // cleanly on aggregation. The bug report observed INV000406 with a
  // non-integer paise totalAmount (743.4) under Float storage — repeated
  // sums of such rows drift by 0.01 per 100-ish invoices and break GSTR-1.
  // DECIMAL(12,2) gives us up to Rs 99,99,99,999.99 per row — well above
  // any realistic single invoice cap. Prisma returns these as
  // Prisma.Decimal objects; billing.ts patches Decimal.prototype.toJSON at
  // module load to emit a JS number, so the on-wire JSON contract stays
  // identical for dashboard / PDF / GSTR-1 / e2e consumers.
  subtotal         Decimal       @db.Decimal(12, 2)
  taxAmount        Decimal       @default(0) @db.Decimal(12, 2)
  // Issue #901: persisted taxable base (= subtotal - all discounts) so
  // GSTR-1 lines have an unambiguous taxable column instead of being
  // derived at render time. Defaults to 0 for legacy rows; the backfill
  // migration sets it for INV000406 and the route fix sets it on every
  // new invoice going forward.
  taxableAmount    Decimal       @default(0) @db.Decimal(12, 2)
  cgstAmount       Decimal       @default(0) @db.Decimal(12, 2) // Central GST half of taxAmount
  sgstAmount       Decimal       @default(0) @db.Decimal(12, 2) // State GST half
  packageDiscount  Decimal       @default(0) @db.Decimal(12, 2) // discount from active HealthPackage
  advanceApplied   Decimal       @default(0) @db.Decimal(12, 2) // deposit applied to this invoice
  discountAmount   Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal       @db.Decimal(12, 2)
  paymentStatus    PaymentStatus @default(PENDING)
  // Razorpay order id stored when /pay-online creates the order; used by
  // the webhook handler to look up the invoice in O(1).
  razorpayOrderId  String?       @unique
  dueDate          DateTime?     @db.Date
  reminderSentAt   DateTime?
  // Late-fee automation (Apr 2026)
  lateFeeAmount    Decimal       @default(0) @db.Decimal(12, 2)
  lateFeeAppliedAt DateTime?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Pearl §7.2 piece 2b — branch ownership. Nullable so existing
  // invoices stay valid; backfilled to tenant.isDefault branch by
  // migration 20260521000002.
  branchId String?
  branch   Branch? @relation("InvoiceBranch", fields: [branchId], references: [id], onDelete: SetNull)

  // Pearl §4.1 (gap row 101) — referring-doctor commission split. Both
  // columns nullable: legacy and walk-in invoices have no referral. When
  // referringDoctorId is set on invoice create, the POST handler resolves
  // a commissionPercent (Referral override → Doctor default) and creates
  // a ReferralCommission snapshot row inside the same transaction.
  // `referralId` (when present) lets the report join back to the
  // originating Referral row; `referringDoctorId` covers walk-in
  // invoices that name a referring doctor without a formal Referral.
  referringDoctorId String?
  referralId        String?

  appointment       Appointment?       @relation(fields: [appointmentId], references: [id])
  admission         Admission?         @relation("AdmissionInvoice", fields: [admissionId], references: [id])
  patient           Patient            @relation(fields: [patientId], references: [id])
  items             InvoiceItem[]
  payments          Payment[]
  insuranceClaims   InsuranceClaim[]
  insuranceClaimsV2 InsuranceClaim2[]
  paymentPlans      PaymentPlan[]
  discountApprovals DiscountApproval[]
  creditNotes       CreditNote[]

  // ── Back-relation merged from .prisma-models-patient-tools.md ────────
  billExplanation BillExplanation?

  // Pearl §4.1 — auto-computed referring-doctor commission snapshot.
  // One-to-one via @unique invoiceId on ReferralCommission.
  referralCommission ReferralCommission?

  @@index([patientId])
  @@index([invoiceNumber])
  @@index([tenantId])
  @@index([branchId])
  @@index([referringDoctorId])
  @@index([admissionId])
  @@index([prescriptionId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  tenantId    String?
  tenant      Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId   String
  description String
  category    String
  quantity    Int     @default(1)
  // Issue #901 (2026-05-19): line-item money fields migrated from Float
  // to DECIMAL(12,2) so per-line × header reconciliation stays exact.
  // `gstRate` remains Float — it is a percentage multiplier, not money.
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  // GST snapshot per line (issue #43 follow-up). Computed at line-item
  // create from the shared computeLineItemTax() helper and persisted so
  // historical invoices retain the exact tax presented to the patient —
  // critical for GSTR-1 audit trail if rates change. cgstAmount + sgstAmount
  // on Invoice continue to carry the rolled-up totals.
  cgst    Decimal @default(0) @db.Decimal(12, 2)
  sgst    Decimal @default(0) @db.Decimal(12, 2)
  gstRate Float   @default(0)
  hsnSac  String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("invoice_items")
}

model Payment {
  id            String           @id @default(uuid())
  invoiceId     String
  amount        Float
  mode          PaymentMode
  // Provider transaction id (Razorpay payment_id, etc.) — unique to enforce
  // idempotency: replays of the same browser callback or webhook MUST NOT
  // create duplicate Payment rows.
  transactionId String?          @unique
  status        PaymentTxnStatus @default(CAPTURED)
  paidAt        DateTime         @default(now())

  // Self-FK back to the original CAPTURED payment — set on REFUNDED rows so
  // `handleRefundProcessed` can sum prior refunds against the same parent
  // and reject a new refund that pushes cumulative past the original
  // captured amount (`REFUND_CUMULATIVE_EXCEEDS_PAYMENT`). Null on
  // CAPTURED/FAILED rows. Indexed for the hot-path sum query.
  parentPaymentId String?
  parent          Payment?  @relation("PaymentRefunds", fields: [parentPaymentId], references: [id], onDelete: SetNull)
  refunds         Payment[] @relation("PaymentRefunds")

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([parentPaymentId])
  @@index([tenantId])
  @@map("payments")
}

model InsuranceClaim {
  id                String      @id @default(uuid())
  invoiceId         String
  patientId         String
  insuranceProvider String
  policyNumber      String
  claimAmount       Float
  approvedAmount    Float?
  status            ClaimStatus @default(SUBMITTED)
  submittedAt       DateTime    @default(now())
  resolvedAt        DateTime?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([invoiceId])
  @@index([patientId])
  @@index([tenantId])
  @@map("insurance_claims")
}

// ─── NOTIFICATIONS ──────────────────────────────────────

model Notification {
  id             String                     @id @default(uuid())
  userId         String
  type           NotificationType
  channel        NotificationChannel
  title          String
  message        String
  data           Json?
  deliveryStatus NotificationDeliveryStatus @default(QUEUED)
  failureReason  String?
  deliveredAt    DateTime?
  scheduledFor   DateTime? // for deferred / quiet-hour respecting sends
  sentAt         DateTime?
  readAt         DateTime?
  createdAt      DateTime                   @default(now())

  // Issue #750: a single broadcast was fanning out as 50+ duplicate
  // notification rows when the same user matched multiple audience
  // filters (e.g. SPECIFIC_USERS + ROLE_DOCTOR) or when the broadcast
  // selected multiple channels — each channel created its own row, so
  // the user saw the SAME message N times. We now stamp every
  // broadcast-originated row with a stable `dedupKey` of the form
  // `${broadcastId}:${userId}` and enforce uniqueness in the DB. The
  // broadcast handler upserts on this key so subsequent channel-loop
  // iterations collapse onto the existing row instead of inserting a
  // dup. `broadcastId` is also stored as a back-reference for
  // operational queries ("which broadcast triggered this row?").
  // Both fields are nullable so non-broadcast notifications (the vast
  // majority — appointment reminders, lab results, etc.) are
  // unaffected.
  broadcastId String?
  dedupKey    String?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id])

  // Pearl §5.1 (gap item #4 — piece 1 of 4) — when a CampaignSend is
  // dispatched through the existing per-channel adapters (piece 2), the
  // resulting Notification row is linked back here for delivery-status
  // joins. Nullable (most Notifications are not campaign-originated).
  campaignSend CampaignSend?

  @@unique([dedupKey])
  @@index([userId, createdAt])
  @@index([deliveryStatus])
  @@index([tenantId])
  @@index([broadcastId])
  @@map("notifications")
}

model NotificationPreference {
  id       String              @id @default(uuid())
  tenantId String?
  tenant   Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  channel  NotificationChannel
  enabled  Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@index([tenantId])
  @@map("notification_preferences")
}

// ─── AUDIT ──────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  // Issue #456 — multi-tenant scoping. Nullable initially so the
  // backfill migration is safe and so bootstrap / system rows
  // (login failures from unknown accounts, cron without a tenant
  // context) can still be written. A follow-up migration tightens
  // this to NOT NULL once the production backfill is verified.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  // Powers the per-tenant Audit Log dashboard (newest first within
  // a tenant). Matches the partial index in
  // 20260504000002_audit_log_tenant_id.
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ─── PEARL §6.1 (gap row 167 — piece 3j-i of 4) — WhatsApp inbox ────────
// Per-tenant WhatsApp provider configuration + bi-directional conversation
// + message log. Pieces 3j-ii / 3j-iii / 3j-iv add the inbound webhook,
// reception inbox UI, and reply endpoint respectively. The legacy outbound
// adapter (services/channels/whatsapp.ts) keeps reading env vars until
// piece 3j-iv. Credentials are stored as a single JSON blob encrypted at
// rest (AES-256-GCM via apps/api/src/services/whatsapp-crypto.ts) so that
// (a) the schema doesn't have to change per-provider as new providers ship
// and (b) the SystemConfig key/value table doesn't have to fan out.

enum WhatsAppProvider {
  GUPSHUP
  WATI
  AISENSEI
  INTERAKT
  META
}

enum WhatsAppConversationStatus {
  OPEN
  SNOOZED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// Generic enough to be reused if a future channel (e.g. RCS, Telegram) needs
// the same lifecycle. Mirrors NotificationDeliveryStatus shape but kept
// distinct because the WhatsApp adapter receives finer-grained webhook
// callbacks (delivered/read/failed) than the broader Notification table.
enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsAppConfig {
  id String @id @default(cuid())

  tenantId String           @unique
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider WhatsAppProvider @default(GUPSHUP)

  // AES-256-GCM ciphertext (base64) — see whatsapp-crypto.ts. In dev/stub
  // mode (WHATSAPP_CREDS_KEY unset) the value is a JSON blob with a
  // `__plaintext: true` marker so the route layer can warn loudly without
  // crashing local dev. Per-provider field shape lives in the Zod schema
  // at packages/shared/src/validation/whatsapp-config.ts.
  credentialsEncrypted String?

  // Optional outbound routing knob used by piece 3j-iv to scope which
  // pre-approved template / product the auto-replies / drips go through.
  defaultProductId String?

  // Whether the (future Stage-2) AI agent auto-replies to inbound messages.
  // Today this is just a persistence column — Stage-1 ships the inbox only.
  autoReply Boolean @default(true)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whatsapp_config")
}

model WhatsAppConversation {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Nullable until the inbound webhook matches the phone number to a
  // Patient row. Receptionists in piece 3j-iii can also manually link a
  // conversation to a patient.
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  // Canonical E.164 (e.g. "+919876543210"). Together with tenantId, this
  // uniquely identifies the conversation.
  phone String

  lastMessageAt DateTime?
  lastInboundAt DateTime?
  unreadCount   Int       @default(0)

  status WhatsAppConversationStatus @default(OPEN)

  // Receptionist who claimed the conversation. Null = unassigned.
  assignedToUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages WhatsAppMessage[]

  @@unique([tenantId, phone])
  @@index([tenantId, lastMessageAt])
  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Denormalised tenantId so the cross-tenant tenant-scoped Prisma
  // extension can filter without a join. Maintained by the route layer.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  direction MessageDirection
  body      String           @db.Text
  mediaUrl  String?

  providerMessageId String?

  status        MessageStatus @default(QUEUED)
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  failureReason String?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("whatsapp_messages")
}

// ─── SYSTEM ─────────────────────────────────────────────

model SystemConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("system_config")
}

model RoleCatalogEntry {
  id           String               @id @default(uuid())
  role         String               @unique
  label        String
  summary      String
  displayOrder Int                  @default(0)
  permissions  RolePermissionItem[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@map("role_catalog_entries")
}

model RolePermissionItem {
  id           String           @id @default(uuid())
  entryId      String
  entry        RoleCatalogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  permission   String
  displayOrder Int              @default(0)
  createdAt    DateTime         @default(now())

  @@index([entryId, displayOrder])
  @@map("role_permission_items")
}

// Pearl ERP Stage 1 §8.4 (gap row 222 closure, 2026-05-22) — observability
// table for the in-process cron scheduler in apps/api/src/services/
// scheduled-tasks.ts. Every invocation of a registered task creates a row
// (status=RUNNING at start, updated to SUCCESS/FAILED on completion) so
// super-admins can see what ran, how long it took, what errored, and retry
// a FAILED row from /super-admin/jobs.
//
// tenantId is nullable because most scheduled tasks operate globally
// (cross-tenant), e.g. notification_drain_queued. Per-tenant tasks should
// populate it for the cross-tenant filter on the admin UI.
model ScheduledTaskRun {
  id               String        @id @default(cuid())
  tenantId         String?
  taskName         String
  status           TaskRunStatus
  startedAt        DateTime
  completedAt      DateTime?
  durationMs       Int?
  error            String? // stack trace truncated at 5000 chars
  recordsProcessed Int?
  // The id of the original run when this row was created by a manual retry
  // from POST /api/v1/scheduled-jobs/:id/retry. Lets the UI link the new
  // run back to the failed parent so operators can see the retry chain.
  retryOfRunId     String?
  createdAt        DateTime      @default(now())

  @@index([taskName])
  @@index([startedAt])
  @@index([status])
  @@index([tenantId, startedAt])
  @@map("scheduled_task_runs")
}

enum TaskRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

// ═══════════════════════════════════════════════════════
// PHASE 2: IPD / INPATIENT MANAGEMENT
// ═══════════════════════════════════════════════════════

model Ward {
  id          String   @id @default(uuid())
  // Ward names are unique PER TENANT (see @@unique below), not globally — each
  // hospital has its own ward namespace, so two tenants can both have a
  // "Ward 1". A global @unique here previously blocked any tenant from
  // creating a name another tenant (or a tenant-less seed row) already used.
  name        String
  type        WardType
  floor       String?
  description String?
  createdAt   DateTime @default(now())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  beds Bed[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("wards")
}

model Bed {
  id        String    @id @default(uuid())
  wardId    String
  bedNumber String
  status    BedStatus @default(AVAILABLE)
  dailyRate Float     @default(0)
  notes     String?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ward       Ward        @relation(fields: [wardId], references: [id])
  admissions Admission[]

  @@unique([wardId, bedNumber])
  @@index([status])
  @@index([tenantId])
  @@map("beds")
}

model Admission {
  id                   String          @id @default(uuid())
  admissionNumber      String          @unique
  patientId            String
  doctorId             String
  bedId                String
  status               AdmissionStatus @default(ADMITTED)
  admittedAt           DateTime        @default(now())
  dischargedAt         DateTime?
  reason               String
  diagnosis            String?
  dischargeSummary     String?
  dischargeNotes       String?
  // Enhanced fields (Apr 2026)
  admissionType        AdmissionType?
  referredByDoctor     String? // external referring physician name
  finalDiagnosis       String?
  treatmentGiven       String?
  conditionAtDischarge String? // STABLE, IMPROVED, CRITICAL, UNCHANGED, DECEASED
  dischargeMedications String?
  followUpInstructions String?
  totalBillAmount      Float?          @default(0)
  // Isolation tracking (Apr 2026)
  isolationType        String? // STANDARD, CONTACT, DROPLET, AIRBORNE, REVERSE_ISOLATION
  isolationReason      String?
  isolationStartDate   DateTime?
  isolationEndDate     DateTime?
  // Expected LOS (Apr 2026)
  expectedLosDays      Int?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patient          Patient            @relation(fields: [patientId], references: [id])
  doctor           Doctor             @relation(fields: [doctorId], references: [id])
  bed              Bed                @relation(fields: [bedId], references: [id])
  ipdVitals        IpdVitals[]
  medicationOrders MedicationOrder[]
  nurseRounds      NurseRound[]
  labOrders        LabOrder[]
  intakeOutputs    IpdIntakeOutput[]
  emergencyCases   EmergencyCase[]    @relation("EmergencyAdmission")
  belongings       PatientBelongings?
  // 2026-05-25: Admission-anchored invoice (zero-amount PENDING placeholder
  // created on admit so the Billing page surfaces every admitted patient
  // immediately; finalized to the bed-charge total on discharge).
  invoice          Invoice?           @relation("AdmissionInvoice")

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([tenantId])
  @@map("admissions")
}

model IpdVitals {
  id                     String   @id @default(uuid())
  admissionId            String
  recordedBy             String // user id
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  temperature            Float?
  pulseRate              Int?
  respiratoryRate        Int?
  spO2                   Int?
  painScore              Int?
  bloodSugar             Int?
  notes                  String?
  recordedAt             DateTime @default(now())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId, recordedAt])
  @@index([tenantId])
  @@map("ipd_vitals")
}

model MedicationOrder {
  id           String    @id @default(uuid())
  admissionId  String
  doctorId     String
  medicineId   String? // link to medicine catalog
  medicineName String
  dosage       String
  frequency    String // e.g. "every 6 hours", "BID", "TID"
  route        String // oral, IV, IM, SC, topical
  startDate    DateTime  @default(now())
  endDate      DateTime?
  instructions String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  admission       Admission                  @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  doctor          Doctor                     @relation(fields: [doctorId], references: [id])
  medicine        Medicine?                  @relation(fields: [medicineId], references: [id])
