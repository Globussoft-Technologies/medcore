/// Issue #718: lightweight admin-managed calendar events (training,
/// closures, town-halls, marketing campaigns, etc.) that don't fit the
/// existing appointment/surgery/telemedicine archetypes already plotted on
/// /dashboard/calendar. Single-row time range, optional color hint, free-
/// text title + category. The frontend's New-Event dialog POSTs here.
model CalendarEvent {
  id          String   @id @default(uuid())
  title       String
  category    String   @default("OTHER")
  startAt     DateTime
  endAt       DateTime
  color       String?
  description String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([startAt])
  @@index([endAt])
  @@index([tenantId])
  @@map("calendar_events")
}

/// Issue #724: insurance partners that the hospital has onboarded for
/// pre-auth and claims. The legacy `INDIAN_INSURERS` constant is the
/// curated dropdown used inside InsuranceClaim2; this table backs the
/// admin Insurance Providers page so new TPAs can be onboarded from UI.
model InsuranceProvider {
  id              String   @id @default(uuid())
  name            String
  code            String   @unique
  contactPerson   String?
  contactEmail    String?
  contactPhone    String?
  coverageDetails String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([name])
  @@index([tenantId])
  @@map("insurance_providers")
}

model NotificationTemplate {
  id        String              @id @default(uuid())
  type      NotificationType
  channel   NotificationChannel
  name      String
  subject   String?
  body      String
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Pearl §5.1 (gap item #4 — piece 1 of 4) — Campaigns that reuse this
  // template for body/subject substitution. Optional FK; an ad-hoc Campaign
  // can author its body inline instead.
  campaigns Campaign[]

  @@unique([type, channel])
  @@index([tenantId])
  @@map("notification_templates")
}

model NotificationSchedule {
  id              String    @id @default(uuid())
  userId          String    @unique
  quietHoursStart String?
  quietHoursEnd   String?
  dndUntil        DateTime?
  updatedAt       DateTime  @updatedAt

  tenantId String?
