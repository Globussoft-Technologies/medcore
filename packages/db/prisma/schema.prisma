// ─── Pearl §5.2 (gap rows 142-145) — chronic-care cohort templates ──────
//
// A ChronicCareCohort is the TENANT-LEVEL template ("all diabetics in
// branch X over age 50") that the auto-enrolment cron uses to materialize
// per-patient ChronicCarePlan rows. The matching DSL lives in `cohortRule`
// and reuses the shape that `services/audience-compiler.ts` already
// understands (shipped via f701b52 for the Campaign domain — Pearl §5.1).
//
// Per-cohort `CohortSequenceStep` rows define the sequence of touchpoints
// (visit-reminder + lab-reminder + education-snippet, etc.) that fan out
// from each enrolment. The scheduler advances step N → N+1 either by
// `delayDays` elapsing OR by the on-visit hook in
// `notification-triggers.ts` (Appointment.status flips to CHECKED_IN
// triggers `advanceChronicCareSequence(patientId)`).
model ChronicCareCohort {
  id          String                @id @default(uuid())
  name        String
  description String?
  condition   ChronicConditionCode?
  // Mirror of CampaignAudience.rules: `{ filters: [...], matchMode:
  // "ALL" | "ANY" }`. Null = manual enrolment only (no cron action).
  cohortRule  Json?
  active      Boolean               @default(true)
  createdBy   String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  steps CohortSequenceStep[]
  plans ChronicCarePlan[]

  @@index([tenantId, active])
  @@index([condition])
  @@map("chronic_care_cohorts")
}

model CohortSequenceStep {
  id                  String                @id @default(uuid())
  chronicCareCohortId String
  // 1-based step ordering within a cohort. Unique per cohort.
  stepNumber          Int
  // Days to wait AFTER the prior step's `lastStepSentAt` (or AFTER
  // enrolment for step 1). 0 = send immediately.
  delayDays           Int                   @default(0)
  // References a NotificationTemplate by stable key (templates are
  // tenant-scoped — resolution happens at send time). Free-form string
  // so future template additions don't require a schema change.
  templateKey         String
  // Channels to fan out per step. Reuses the existing
  // `NotificationChannel` enum.
  channels            NotificationChannel[]
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cohort ChronicCareCohort @relation(fields: [chronicCareCohortId], references: [id], onDelete: Cascade)

  @@unique([chronicCareCohortId, stepNumber])
  @@index([chronicCareCohortId, active])
  @@index([tenantId])
  @@map("cohort_sequence_steps")
}

model ChronicCareCheckIn {
  id                 String   @id @default(uuid())
  planId             String
