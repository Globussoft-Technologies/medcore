// ─── PATIENT ────────────────────────────────────────────

model Patient {
  id                           String    @id @default(uuid())
  userId                       String    @unique
  mrNumber                     String    @unique
  dateOfBirth                  DateTime? @db.Date
  age                          Int?
  gender                       Gender
  address                      String?
  bloodGroup                   String?
  // Patient contact email. Distinct from the login `User.email` (which is
  // globally unique because it's the sign-in identity). A patient's email
  // is NOT a login credential here, so it is stored on the Patient row and
  // is unique only WITHIN a tenant — two tenants may each have a patient
  // with the same email, and a patient may reuse an email that a staff
  // login already uses in another tenant. The create handler mirrors this
  // into `User.email` only when that email is still globally free, so
  // existing login-by-email behaviour is preserved where possible.
  contactEmail                 String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  // Issue #713 (May 2026): captured at public registration time alongside
  // name/phone/address so casualty / triage staff can dial the right person
  // without first hop-pinging the patient profile editor.
  emergencyContactRelationship String?
  insuranceProvider            String?
  insurancePolicyNumber        String?
  maritalStatus                String?
  occupation                   String?
  religion                     String?
  preferredLanguage            String?
  abhaId                       String?
  aadhaarMasked                String?
  photoUrl                     String?
  mergedIntoId                 String?
  // Family linking (Apr 2026)
  guardianPatientId            String?
  // No-show policy (Apr 2026)
  noShowCount                  Int       @default(0)
  // Pricing tier (Apr 2026) — STANDARD, EMPLOYEE, SENIOR_CITIZEN, BPL, VIP
  pricingTier                  String    @default("STANDARD")

  // Pearl ERP Stage 1 §2.1.1 — attribution tag for where this Patient row
  // came from (web panel / patient PWA / walk-in / referral / WhatsApp /
  // phone / other). Default WALK_IN so legacy rows that pre-date this
  // column don't need a per-row backfill — the migration's column DEFAULT
  // handles it. Staff `POST /api/v1/patients` defaults to WEB at the route
  // layer when the body omits a source; the patient PWA self-registration
  // path defaults to PWA when that flow is wired (deferred — see commit
  // message).
  source PatientSource @default(WALK_IN)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Pearl §7.2 piece 2b — branch ownership. Nullable so existing
  // patients stay valid; backfilled to tenant.isDefault branch by
  // migration 20260521000002.
  branchId String?
  branch   Branch? @relation("PatientBranch", fields: [branchId], references: [id], onDelete: SetNull)

  // Pearl §5.1 audience-builder demographic filter — explicit city field
  // separate from the freetext address column. Optional; legacy patients
  // remain valid with city=null (filter only matches non-null rows when
  // a city filter is active).
  city String?

  // SOW §2.1.1 registration address triplet — state + PIN captured alongside
  // city at registration. Optional so legacy rows stay valid.
  state   String?
  pincode String?

  // Pearl §5.1 audience-builder opt-in filter for WhatsApp campaigns.
  // Default false (must explicitly opt in to be eligible for marketing
  // pushes). DPDP-aligned — consent must be affirmative.
  whatsappOptIn Boolean @default(false)

  user                 User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardian             Patient?                   @relation("PatientGuardian", fields: [guardianPatientId], references: [id])
  dependents           Patient[]                  @relation("PatientGuardian")
  familyLinks          PatientFamilyLink[]        @relation("PatientPrimary")
  familyLinkedBy       PatientFamilyLink[]        @relation("PatientRelated")
  appointments         Appointment[]
  vitals               Vitals[]
  prescriptions        Prescription[]
  invoices             Invoice[]
  insuranceClaims      InsuranceClaim[]
  admissions           Admission[]
  labOrders            LabOrder[]
  allergies            PatientAllergy[]
  chronicConditions    ChronicCondition[]
  familyHistory        FamilyHistory[]
  immunizations        Immunization[]
  documents            PatientDocument[]
  referralsFrom        Referral[]                 @relation("PatientReferrals")
  surgeries            Surgery[]
  packagePurchases     PackagePurchase[]
  telemedicineSessions TelemedicineSession[]
  emergencyCases       EmergencyCase[]
  bloodRequests        BloodRequest[]
  ambulanceTrips       AmbulanceTrip[]
  ancCase              AntenatalCase?
  growthRecords        GrowthRecord[]
  feedbacks            PatientFeedback[]
  complaints           Complaint[]
  visitors             Visitor[]
  waitlistEntries      WaitlistEntry[]
  coordinatedVisits    CoordinatedVisit[]
  paymentPlans         PaymentPlan[]
  preAuthRequests      PreAuthRequest[]
  controlledEntries    ControlledSubstanceEntry[]
  advanceDirectives    AdvanceDirective[]
  medReconciliations   MedReconciliation[]
  milestoneRecords     MilestoneRecord[]
  feedingLogs          FeedingLog[]
  radiologyStudies     RadiologyStudy[]
  aiTriageSessions     AITriageSession[]
  aiScribeSessions     AIScribeSession[]
  abhaLinks            AbhaLink[]
  consentArtefacts     ConsentArtefact[]
  careContexts         CareContext[]
  abdmTransactions     AbdmTransaction[]
  medicalRecords       MedicalRecord[]
  recordUploads        RecordUpload[]
  insuranceClaimsV2    InsuranceClaim2[]
  doseLogs             AdherenceDoseLog[]

  // ── Back-relations merged from .prisma-models-patient-tools.md ───────
  billExplanations    BillExplanation[]
  previsitChecklists  PrevisitChecklist[]
  symptomDiaryEntries SymptomDiaryEntry[]
  chronicCarePlans    ChronicCarePlan[]
  chronicCareCheckIns ChronicCareCheckIn[]
