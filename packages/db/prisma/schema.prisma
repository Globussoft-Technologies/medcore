  active               Boolean              @default(true)
  createdBy            String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Pearl §5.2 (gap rows 142-145, 2026-05-23) — when this plan was
  // auto-created from a ChronicCareCohort template (rule-DSL match),
  // `cohortId` links back to the template so the sequence stepper can
  // look up the next CohortSequenceStep. Manual plans (today's default)
  // leave this null — full back-compat.
  cohortId String?
  cohort   ChronicCareCohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

