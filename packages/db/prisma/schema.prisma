// ─── DPDP CROSS-TENANT ERASURE WORKBENCH (Pearl §8.6 — gap row 224) ─────
//
// Right-to-erasure (DPDP Act 2023 §17). Filed by the patient themselves, an
// external DPO, or a super-admin acting on their behalf. The workbench at
// /super-admin/dpdp lists rows and lets the super-admin EXECUTE (runs the
// cross-table purge transaction in services/dpdp-purge.ts) or REJECT.
//
// We retain this table — and the AuditLog rows it emits — even after a
// COMPLETED purge, because the regulator's audit requirement supersedes
// the patient's right to be forgotten ABOUT the request itself (only the
// substantive PII is purged). `executionReceipt` captures which tables
// were purged + counts so a regulator can verify the action.
enum ErasureStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  REJECTED
}

model DPDPErasureRequest {
  id               String        @id @default(uuid())
  tenantId         String
  patientId        String
  // Who initiated. For PATIENT/SUPER_ADMIN this is the User.id; for
  // DPO_EXTERNAL we store the contact email (no user row exists).
  requestedBy      String
  requestedByRole  String // PATIENT | DPO_EXTERNAL | SUPER_ADMIN
  reason           String?       @db.Text
  status           ErasureStatus @default(PENDING)
  requestedAt      DateTime      @default(now())
  executedAt       DateTime?
  executedBy       String? // User.id of the super-admin who ran the purge
  executionReceipt Json? // { purgedTables, purgedRows, anonymizedTables, retainedTables, notes }
  failureReason    String?       @db.Text

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([requestedAt])
  @@index([patientId])
  @@map("dpdp_erasure_requests")
}

// Curated SNOMED-CT subset (~120 concepts) for Indian OPD presentations.
// Global reference catalogue — NOT tenant-scoped. Mirrors Icd10Code shape.
model SnomedConcept {
  id            String   @id
  term          String
  synonyms      Json
  specialtyTags Json
  redFlagTerms  Json
  category      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([term])
  @@map("snomed_concepts")
}

// Front-desk telephony CDR log — sinks Twilio/Exotel/Ozonetel webhooks so
// we can honestly compute the §3.9 "front-desk call volume for triage" KPI.
model FrontDeskCall {
  id          String   @id @default(uuid())
  calledAt    DateTime
  durationSec Int
  fromPhone   String
  toPhone     String?
  category    String? // "TRIAGE" | "BILLING" | "APPT_CHANGE" | "OTHER"
  disposition String? // "RESOLVED" | "ABANDONED" | "TRANSFERRED"
  providerId  String?
  createdAt   DateTime @default(now())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([calledAt])
  @@index([category])
  @@map("front_desk_calls")
}

// Scribe-assisted-vs-manual medication-error tracking (PRD §4.9).
// Narrative-first so the incident capture UI stays low-friction.
model MedicationIncident {
  id               String    @id @default(uuid())
  patientId        String
  prescriptionId   String?
  reportedByUserId String
  reportedAt       DateTime  @default(now())
  severity         String // "NEAR_MISS" | "MINOR" | "MODERATE" | "SEVERE"
  scribeSessionId  String?
  narrative        String    @db.Text
  resolvedAt       DateTime?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescription   Prescription?    @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  reportedByUser User             @relation("MedicationIncidentReporter", fields: [reportedByUserId], references: [id])
  scribeSession  AIScribeSession? @relation(fields: [scribeSessionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([reportedAt])
  @@index([scribeSessionId])
  @@index([patientId])
  @@map("medication_incidents")
}

// ─── PEARL §5.1 CAMPAIGN ENGINE (gap item #4 — piece 1 of 4) ─────────────
// Per the gap analysis (docs/PEARL_STAGE1_GAP_ANALYSIS.md §5 + §7 row #4),
// MedCore today has NotificationBroadcast (single-shot send-to-audience-
// string) and ChronicCarePlan (per-patient care plans). Pearl §5.1 needs
// the richer multi-stage campaign cousin: drip / trigger / cohort, A/B
// variants, conversion attribution, send-window clamps, audience builder
// DSL. Piece 1 of 4 ships the data model + CRUD API only — the audience
// compiler ships in piece 2, A/B + tracking in piece 3, UI in piece 4.
//
// Coexists with NotificationBroadcast (not a replacement). Existing
// /dashboard/broadcasts continues to work for one-off blasts.

model Campaign {
  id          String         @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)
  kind        CampaignKind   @default(BROADCAST)

  // Multi-channel fan-out. A single Campaign can send the SAME message
  // body across all enabled channels; piece 2's dispatcher will create
  // one CampaignSend row per (recipient × channel) and one Notification
  // row per send via the existing per-channel adapters.
  channels CampaignChannel[]

  // Optional template reference. If null, body+subject below are the
  // free-text source (with {{patient.firstName}}-style tokens that the
  // piece-2 dispatcher substitutes).
  templateId String?
  template   NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  subject String? // for EMAIL channel
  body    String? @db.Text

  // Audience — saved CampaignAudience rule that the piece-2 compiler
  // resolves to a patient set. Nullable so a Campaign can be drafted
  // before its audience is chosen (or set inline at send time).
  audienceId String?
  audience   CampaignAudience? @relation(fields: [audienceId], references: [id], onDelete: SetNull)

  // Lifecycle timestamps. scheduledAt is set when status flips
  // DRAFT → SCHEDULED; startedAt + completedAt are written by the
  // piece-2 dispatcher; cancelledAt + cancelReason are set when an
  // operator cancels in-flight or before launch.
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  // Send-window clamp (Pearl §5.1 — IST quiet-hour respect). Integer
  // minute-of-day, 0..1439. Both must be set together (API-validated).
  // The dispatcher clamps every send to fall within this window.
  sendWindowStart Int?
  sendWindowEnd   Int?

  // A/B variants — persisted config; resolution + weighting ships in piece 3.
  // Shape: [{ id, weight, subjectOverride?, bodyOverride? }].
  abVariants Json?

  // Pearl §5.1 piece 3c — destination URL the click endpoint 302s to
  // after recording clickedAt. Per-campaign so the marketer can land
  // each campaign on its own page (booking deep-link / landing page /
  // form). When null the click endpoint records clickedAt and returns
  // a plain-text 200 acknowledgement.
  linkTargetUrl String?

  // Operator who created the campaign (audit trail; nullable in case the
  // creator user is later deleted — onDelete: SetNull preserves the row).
  createdById String?
  createdBy   User?   @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sends  CampaignSend[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([scheduledAt])
  @@map("campaigns")
}

model CampaignAudience {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  description String?

  // DSL placeholder. Piece 2 of 4 defines the compiler that turns this
  // JSON into a Prisma `where` over Patient. Suggested shape:
  //   { filters: [{ field, op, value }, ...], cohortId?, includeOptedOut? }
  // Stored as Json to keep the schema flexible while the DSL solidifies.
  rules Json

  // Last computed audience size (written by the piece-2 compiler when
  // POST /api/v1/campaigns/:id/sends/preview is called).
  estimatedSize  Int?
  lastComputedAt DateTime?

  // Soft-active flag — audiences referenced by historical Campaigns
  // must not be hard-deleted; the PATCH-active=false flow is the only
  // way to retire one (the routes file deliberately omits a DELETE).
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([tenantId])
  @@index([tenantId, active])
  @@map("campaign_audiences")
}

model CampaignSend {
  id         String          @id @default(cuid())
  campaignId String
  // Denormalized tenantId so tenant-scoped queries don't need a Campaign
  // join. Always equals campaign.tenantId; enforced by the dispatcher
  // when writing the row in piece 2.
  tenantId   String
  patientId  String
  channel    CampaignChannel
  // A/B variant resolved at dispatch time (piece 3). Free-text id so the
  // schema doesn't need to evolve when the variant config shape does.
  variantId  String?

  status SendStatus @default(QUEUED)

  // Status-transition timestamps. The piece-2 dispatcher writes sentAt
  // immediately when the channel-adapter accepts the payload. The
  // delivery / read callbacks (WhatsApp business API, email open beacon,
  // etc.) backfill deliveredAt / readAt asynchronously.
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  failureReason String?

  // Pearl §5.1 piece 3c — click + conversion attribution.
  //   clickedAt        set by GET /api/v1/campaigns/click/:sendId
  //                    when the recipient taps the trackable URL the
  //                    dispatcher minted into the message body.
  //   convertedAt      set by recordCampaignConversion() when a
  //                    downstream event (appointment booked / invoice
  //                    generated within the attribution window — default
  //                    7 days) is credited to this send.
  //   convertedRefId   id of the appointment/invoice that earned the
  //                    credit (drill-down from the stats endpoint).
  //   convertedType    "APPOINTMENT" | "INVOICE" | future. Kept as
  //                    free text so the catalog can grow without a
  //                    chained schema migration.
  clickedAt      DateTime?
  convertedAt    DateTime?
  convertedRefId String?
  convertedType  String?

  // Pearl §5.1 — bounce + unsubscribe tracking (delivery-quality + opt-out).
  //   bouncedAt       set when a channel callback reports a bounce (status
  //                   also flips to BOUNCED). Distinct from failedAt (a
  //                   send-time failure) — a bounce happens post-accept.
  //   unsubscribedAt  set when the recipient taps the one-tap unsubscribe link
  //                   (GET /public/campaigns/unsubscribe/:sendId). Also clears
  //                   Patient.whatsappOptIn so future campaigns skip them.
  bouncedAt      DateTime?
  unsubscribedAt DateTime?

  // FK to the Notification row created via the existing per-channel
  // adapter (piece 2). Optional because some channels (e.g. raw SMS via
  // a non-Notification path) may not have a 1:1 Notification row.
  notificationId String?       @unique
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([tenantId])
  @@index([campaignId, status])
  @@index([patientId])
  // Pearl §5.1 piece 3c — attribution lookup: "find the patient's
  // most recent clicked-but-not-converted CampaignSend within the
  // attribution window". `convertedAt IS NULL` filter prunes the
  // small tail in-memory.
  @@index([patientId, clickedAt])
  @@map("campaign_sends")
}

// ============================================================================
// Pearl ERP Stage 1 §8.5 (gap row 223 closure 2026-05-23) — Pearl-operator
// support inbox.
//
// Tenant-ADMIN → Pearl-operator (super-admin) ticket lifecycle. Distinct from
// `Complaint` (patient → hospital). Threading via SupportTicketMessage:
// each reply flips the ticket back and forth between OPEN (tenant just
// wrote) and AWAITING_TENANT (super-admin just replied), so both sides see
// a clear "needs my attention" filter.
//
// Super-admin (tenantId == null OR seeded "default" tenant) sees all
// tickets across all tenants; tenant-ADMIN sees only own tenant's rows.
// Per-row scoping enforced in apps/api/src/routes/support-tickets.ts.
// ============================================================================
model SupportTicket {
  id               String                @id @default(uuid())
  // Raising tenant. Nullable so a super-admin can file an internal-only
  // ticket (no tenant context) — same flexibility the DPDP workbench has.
  tenantId         String?
  openedByUserId   String
  subject          String
  body             String
  status           SupportTicketStatus   @default(OPEN)
  priority         SupportTicketPriority @default(NORMAL)
  assignedToUserId String?
  resolvedAt       DateTime?
  // Pearl §8.5 — plan-aware SLA. `slaDueAt` is computed on create
  // (and recomputed whenever priority changes) by combining the
  // tenant's subscription plan with the ticket's priority. See
  // services/support-ticket-sla.ts:computeSlaDueAt(). `slaPlan` is
  // the plan name as resolved at creation time so re-pricing later
  // doesn't retro-shift historical deadlines.
  slaDueAt         DateTime?
  slaPlan          String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  tenant     Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  openedBy   User                   @relation("SupportTicketOpener", fields: [openedByUserId], references: [id])
  assignedTo User?                  @relation("SupportTicketAssignee", fields: [assignedToUserId], references: [id])
  messages   SupportTicketMessage[]

  @@index([tenantId, status])
  @@index([assignedToUserId, status])
  @@index([status, updatedAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id           String   @id @default(uuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId     String
  authorUserId String
  body         String
  createdAt    DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorUserId], references: [id])

  @@index([ticketId, createdAt])
  @@index([tenantId])
  @@map("support_ticket_messages")
}

enum SupportTicketStatus {
  OPEN
  AWAITING_TENANT
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Pearl ERP Stage 1 §8.2 (gap row 213 closure, 2026-05-23) — staff
// email-invite flow.
//
// Today the ADMIN-side "create user" UX requires the admin to type a
// password and share it out-of-band, which (a) leaks the password in
// chat / email plaintext, (b) skips email-verification (the new user
// might not actually own the address), and (c) blocks self-service
// onboarding of a roster of staff. This model captures the "invite
// pending acceptance" state between the admin issuing an invite and
// the recipient materialising their User row by setting a password.
//
// Token storage contract:
//   - `token` holds the SHA-256 hex hash of a 32-byte CSPRNG nonce.
//   - The raw nonce ONLY ever leaves the server in the outbound email
//     body; we never persist it. A DB compromise therefore cannot be
//     used to assume any unaccepted invite — the attacker would need
//     the email contents too.
//   - On accept, the User row is created with the role + tenantId
//     captured at invite-time (NOT what the URL says — prevents a
//     forged Role on the accept body from privilege-escalating).
//
// `branchIds` is a denormalised string[] of Branch.id values that the
// new user should be assigned to once Pearl §7.2 piece 2b lands the
// per-user branch ACL. Today the field is stored for the audit trail
// and surfaced verbatim on the accept GET, but no enforcement reads
// it — the staff-user model has no branch ACL yet.
//
// Lifecycle: an invite is "active" while expiresAt > now() AND
// acceptedAt IS NULL. Re-inviting the same email collapses any
// outstanding active invites (the POST handler does a DELETE-then-
// INSERT) so a victim of an email-typo can re-send without leaving
// the wrong-address invite valid in the wild.
model UserInvite {
  id              String    @id @default(uuid())
  tenantId        String
  email           String
  role            Role
  branchIds       String[]  @default([])
  token           String    @unique // sha256 hex of the raw nonce
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedUserId  String?
  createdAt       DateTime  @default(now())

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy    User   @relation("UserInviteInviter", fields: [invitedByUserId], references: [id])
  acceptedUser User?  @relation("UserInviteAcceptedUser", fields: [acceptedUserId], references: [id])

  @@index([tenantId, email])
  @@index([expiresAt])
  @@map("user_invites")
}

// Pearl ERP Stage 1 §8.4 (2026-05-28) — per-tenant request health metrics.
//
// One row per request that is "interesting" — either slow (≥ 1000 ms) or
// errored (statusCode ≥ 500). Routine fast requests are NOT logged so
// the table doesn't grow at request rate (would be millions/day per
// tenant). The endpoint-level aggregates the operator needs — error
// rate, p95 latency, top slow endpoints — are computed on top of this
// sampled-by-condition set.
//
// `pathTemplate` is the route's template (`/api/v1/patients/:id`), NOT
// the realised URL (`/api/v1/patients/abc-123`) so we don't burst the
// index with cardinality from path params. The metrics middleware
// (apps/api/src/middleware/metrics.ts) reads `req.route.path` after
// the matcher resolves; if that's missing it falls back to a
// best-effort normalisation that replaces UUID-shaped + numeric path
// segments with `:id`.
//
// `tenantId` is nullable for two reasons: (a) unauthenticated /
// public routes (login, status, payment webhooks) have no tenant
// context; (b) cross-tenant super-admin operators run with
// `tenantId=null` on every request. Both cases are useful to log so
// the platform-wide aggregate works.
model RequestMetric {
  id           String   @id @default(uuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  method       String // GET / POST / PATCH / DELETE / PUT
  pathTemplate String // "/api/v1/patients/:id" — normalised, NOT the realised path
  statusCode   Int
  durationMs   Int
  userId       String? // best-effort principal at request time
  errorMessage String? // short rendering of the thrown error, only set on 5xx
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([pathTemplate, createdAt])
  @@index([statusCode, createdAt])
  @@map("request_metrics")
}

// Pearl ERP Stage 1 §8.4 (2026-05-28) — scheduled maintenance windows.
//
// Surfaced on the public status page so visitors see upcoming /
// in-progress maintenance instead of generic "operational" while the
// platform is being intentionally taken down. Operators CRUD these
// through /dashboard/observability. The status route
// (`apps/api/src/routes/status.ts`) reads upcoming + active windows
// and merges them into its response.
//
// `affectsComponents` is a free-form string array (e.g. ["api",
// "database"]) — kept as raw strings so the operator can add a new
// component without a schema change.
model MaintenanceWindow {
  id                String   @id @default(uuid())
  title             String
  description       String?
  startsAt          DateTime
  endsAt            DateTime
  affectsComponents String[] @default([])
  status            String   @default("scheduled") // scheduled | in_progress | completed | cancelled
  createdByUserId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([startsAt])
  @@index([status, endsAt])
  @@map("maintenance_windows")
}
