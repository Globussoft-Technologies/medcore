// ═══════════════════════════════════════════════════════
// PHASE 4: PATIENT FEEDBACK & COMPLAINTS
// ═══════════════════════════════════════════════════════

model PatientFeedback {
  id             String           @id @default(uuid())
  patientId      String
  // PRD §3.9 — AI-flow CSAT needs a precise appointment anchor (the triage
  // summary note-marker approach over-counted unrelated walk-ins).
  appointmentId  String?
  category       FeedbackCategory
  rating         Int
  nps            Int?
  comment        String?
  sentiment      SentimentLabel? // derived from comment content
  sentimentScore Float? // -1..+1
  requestedVia   String? // SMS, EMAIL, WALK_IN
  submittedAt    DateTime         @default(now())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  // ── Back-relation merged from .prisma-models-ops-quality.md ──────────
  aiSentiment FeedbackSentiment?

  @@index([patientId])
  @@index([category])
  @@index([submittedAt])
  @@index([sentiment])
  @@index([tenantId])
  @@index([appointmentId])
  @@map("patient_feedback")
}

model Complaint {
  id               String          @id @default(uuid())
  ticketNumber     String          @unique
  patientId        String?
  name             String?
  phone            String?
  category         String
  subCategory      String?
  description      String
  status           ComplaintStatus @default(OPEN)
  assignedTo       String?
  resolution       String?
  resolvedAt       DateTime?
  slaDueAt         DateTime?
  escalatedAt      DateTime?
  escalationReason String?
  priority         String          @default("MEDIUM")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patient Patient? @relation(fields: [patientId], references: [id])

  @@index([status])
  @@index([assignedTo])
  @@index([slaDueAt])
  @@index([tenantId])
  @@map("complaints")
}

// ═══════════════════════════════════════════════════════
// PHASE 4: INTERNAL CHAT / MESSAGING
// ═══════════════════════════════════════════════════════

model ChatRoom {
  id            String    @id @default(uuid())
  name          String?
  isGroup       Boolean   @default(false)
  isChannel     Boolean   @default(false) // department-wide broadcast channel
  department    String? // e.g. "Doctors", "Nursing", "All Staff"
  createdBy     String
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([department])
  @@index([tenantId])
  @@map("chat_rooms")
}

model ChatParticipant {
  id         String    @id @default(uuid())
  roomId     String
  userId     String
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?
  lastReadAt DateTime?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("chat_participants")
}

model ChatMessage {
  id              String      @id @default(uuid())
  roomId          String
  senderId        String
  type            MessageType @default(TEXT)
  content         String
  attachmentUrl   String?
  reactions       Json? // { "👍": [userId,...], "❤️": [userId,...] }
  mentionIds      String? // comma-separated userIds from @mentions
  isPinned        Boolean     @default(false)
  pinnedAt        DateTime?
  pinnedBy        String?
  parentMessageId String? // for threading/replies
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation("MessageSender", fields: [senderId], references: [id])

  @@index([roomId, createdAt])
  @@index([senderId])
  @@index([isPinned])
  @@index([tenantId])
  @@map("chat_messages")
}

