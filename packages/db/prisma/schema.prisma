// ─── AI PROMPT REGISTRY (GAP-P3) ────────────────────────
//
// Versioned prompt templates for all LLM features. Replaces the hardcoded
// string constants in apps/api/src/services/ai/prompts.ts so prompt edits
// no longer require a code deploy. Exactly one row per `key` has
// `active = true`; flipping a different version's `active` flag is an
// instant rollback/rollout. Enforcement of the single-active invariant is
// done at the application layer (services/ai/prompt-registry.ts) inside
// a transaction — the partial unique index below is a defense-in-depth
// guard at the DB level.

model Prompt {
  id        String   @id @default(uuid())
  key       String
  version   Int
  content   String   @db.Text
  createdBy String
  createdAt DateTime @default(now())
  active    Boolean  @default(false)
  notes     String?

  // One row per (key, version); many versions per key.
  @@unique([key, version])
  // Filterable by key for the "list versions" admin endpoint.
  @@index([key])
  // Partial unique index on (key) WHERE active = true is declared in the
  // migration SQL (Prisma cannot express partial indexes in the schema).
  @@map("prompts")
}

