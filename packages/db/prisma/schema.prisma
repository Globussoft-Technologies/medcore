  // = nothing sent yet (initial state after enrolment). The scheduler
  // advances `lastStepSent` after each successful send + records
  // `lastStepSentAt` so the next step's `delayDays` is measured from
  // the prior send (not from enrolment time).
  lastStepSent   Int       @default(0)
  lastStepSentAt DateTime?

