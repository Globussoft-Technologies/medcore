model PlatformPlan {
  id                  String   @id @default(uuid())
  key                 String   @unique
  name                String
  monthlyPriceInPaise Int
  includedFeatures    String[] @default([])
  active              Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Dynamic, DB-backed catalog of super-admin permission grants. Mirrors the
// PlatformPlan pattern: seeded from SUPER_ADMIN_PERMISSIONS in @medcore/shared,
// but at runtime the invite form + API validation read this table so grants
// can be added / edited / disabled without a code change. Per-operator grant
// VALUES are still stored as JSON in SystemConfig (`superadmin:<id>:permissions`);
// this table is just the catalog of available grant keys + their copy.
model SuperAdminPermission {
  id             String   @id @default(uuid())
  key            String   @unique
  label          String
  description    String
  defaultGranted Boolean  @default(false)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Pearl ERP Stage 1 §8.3 (gap rows 215-218 closure piece 3a 2026-05-24) —
// platform-billing subscription state machine. `trial` is the first 30
// days after tenant creation; on `trialEndsAt` the daily cron flips to
// `past_due` (7-day read-only grace) and then to `suspended` (login
// blocked except for billing). `cancelled` is operator-initiated; the
// tenant row stays for audit/data-retention but no further invoices are
// generated.
enum SubscriptionStatus {
  trial
  active
  past_due
  suspended
  cancelled
}

// ─── MULTI-TENANCY ──────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  subdomain String   @unique
  plan      String   @default("STARTER") // PlatformPlan.key
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Pearl Stage 1 §8.1 row 233 closure (2026-05-25) — 90-day S3 archival.
  // `deactivatedAt` is stamped by `deactivateTenant()` (suspend) and
  // cleared by `activateTenant()` (restore). The daily
  // `tenant_archive_sweep` cron (`services/tenant-archival.ts:
  // findArchiveCandidates`) treats `active=false AND deactivatedAt is
  // older than 90 days AND archivedAt is null` as the eligibility
  // gate. `archivedAt` + `archiveS3Key` + `archiveSizeBytes` +
  // `archiveChecksum` are populated by `archiveTenant()` once the
  // tarball is uploaded to S3 (key: `tenant-archives/{tenantId}/{ts}.
  // tar.gz`). Live-data purge is a SEPARATE operator-gated callable
  // (`purgeArchivedTenant()`) — not auto-wired to any cron.
  deactivatedAt    DateTime?
  archivedAt       DateTime?
  archiveS3Key     String?
  archiveSizeBytes Int?
  archiveChecksum  String? // SHA-256 of the uploaded tarball

  // Pearl ERP Stage 1 gap item #10b — per-tenant Razorpay credentials.
  // Today services/razorpay.ts reads RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET
  // from process.env, which only works for single-tenant deploys. For
  // multi-tenant Pearl pilots, each hospital has its own merchant account
  // and needs its own keys. When these fields are NULL the runtime falls
  // back to the env vars (back-compat for existing single-tenant deploys).
  //
  // razorpayMode = "live" | "test" — informational + drives the gateway URL.
  // razorpayKeySecret is stored AS-IS for now (encryption-at-rest is a
  // separate ops follow-up; the column is already FK-cascade-protected
  // and the DB is encrypted at the filesystem layer on prod).
  razorpayKeyId     String?
  razorpayKeySecret String?
  razorpayMode      String? // "live" | "test"

  // Pearl ERP Stage 1 §8.3 piece 3d (2026-05-28) — platform-billing
  // recipient + tax fields. When `billingContactEmail` is set, the
  // monthly invoice mailer (services/platform-invoice-mailer.ts) sends
  // the generated PlatformInvoice to that address; when null we skip
  // sending and log a warning so the operator can fill it in.
  // `gstinNumber` + `stateCode` (e.g. "KA") are persisted here so the
  // invoice generator can stop falling back to `Branch.state` for the
  // CGST/SGST vs IGST split.
  billingContactEmail String?
  gstinNumber         String?
  stateCode           String?

  // Pearl §8.6 (2026-05-28) — per-tenant compliance posture knobs.
  // Surfaced on the /super-admin/compliance dashboard so the
  // operator can demand a tenant turn a feature on (e.g. ABDM
  // consent enforcement before go-live with a national-scheme
  // integration) without a code deploy. Each is documented
  // separately so a future audit can see exactly which knob covers
  // which regulatory ask.
  //
  //   whatsappOptInTrackingEnabled — when true, the WhatsApp send
  //     path refuses to deliver to numbers that don't have an
  //     OptInRecord for this tenant. DPDP §15 compliance flag.
  //   abdmConsentEnforcementRequired — when true, ABDM-bound
  //     fetches require an active ConsentArtefact before pulling
  //     records. National-scheme regulatory ask.
  //   auditLogRetentionDays — floor for the audit-archival cron.
  //     Default 365d; pushed up to 1825/2555 for NABH-accredited
  //     tenants per their auditor's findings.
  //   patientDataRetentionDays — floor for the patient-row purge
  //     cron. Default 2555d (≈ 7y, MCI guidance). DPDP erasure
  //     requests bypass this — the floor is for routine purges.
  whatsappOptInTrackingEnabled   Boolean @default(false)
  abdmConsentEnforcementRequired Boolean @default(false)
  auditLogRetentionDays          Int     @default(365)
  patientDataRetentionDays       Int     @default(2555)

  // Pearl ERP Stage 1 gap item #10b — mandatory TOTP for tenant ADMIN.
  // When true, ADMIN users on this tenant who haven't enrolled TOTP are
  // blocked at the login step with a 412 + "TOTP enrolment required"
  // message. Pearl-branded tenants set this to true; non-Pearl tenants
  // leave it false (current default — opt-in TOTP only).
  requireAdminTOTP Boolean @default(false)

  // Pearl ERP Stage 1 §8.2 gap row 212 — per-tenant idle session timeout
  // (configurable). Captures how many minutes a tenant's users may sit
  // idle before being considered logged out. The value is rendered in
  // the super-admin tenant edit drawer; super-admins write through the
  // existing PATCH /api/v1/tenants/:id handler (range [5, 1440] enforced
  // by Zod). JWT TTL enforcement (auth.ts) is explicitly DEFERRED to a
  // separate piece — that touches token-signing code which is high-risk
  // and out of scope for this row. Default 30 mirrors the legacy
  // global JWT_TTL_MIN default.
  sessionIdleMinutes Int @default(30)

  // Pearl ERP Stage 1 §6 + §18 (gap item #9) — per-tenant feature flags.
  // JSON shape:
  //   { "<featureKey>": true | false, ... }
  //   featureKey ∈ packages/shared/src/feature-flags.ts FEATURE_KEYS.
  // Default for every existing tenant = null = "all features enabled"
  // (current MedCore behaviour — no regression). Pearl-branded tenants
  // explicitly set the §6 list to false to hide Stage-2+ surfaces (IPD,
  // OT, telemedicine, voice-rx, AI-discharge, predictive CDS, AI
  // radiology, HRMS, NABH dashboard, etc.) so the OPD-class scope stays
  // clean and matches the SoW the hospital signed.
  //
  // Resolution at runtime:
  //   - apps/api: services/feature-flags.ts → isFeatureEnabled(tenantId, key)
  //   - apps/web: lib/feature-flags-client.ts wraps GET /api/v1/feature-flags
  //   - middleware/feature-flag.ts blocks API routes for disabled features
  //     with 404 (not 403 — Pearl tenants shouldn't even learn the routes
  //     exist).
  featureFlags Json?

