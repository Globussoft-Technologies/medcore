// and is the default for backward compatibility.
enum AppointmentMode {
  CALLING
  TOKEN
  SLOT
}

// Pearl ERP Stage 1 §3.2 — per-doctor enabled booking channels. The
// `appointmentMode` enum above picks the booking SHAPE; this enum picks
// the booking CHANNELS the doctor accepts. A doctor may run TOKEN-mode
// but disable WALKIN; or run SLOT-mode and accept CALLING for triage.
// Stored as `Doctor.enabledChannels AppointmentChannel[]`; an empty
// array means "all channels permitted" (back-compat default).
enum AppointmentChannel {
  CALLING
  SLOT
  TOKEN
  WALKIN
}

