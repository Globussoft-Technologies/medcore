  // ── PRD closure (2026-04-24) ─────────────────────────────
  dataExports         PatientDataExport[]
  medicationIncidents MedicationIncident[]

  // Pearl §6.1 (gap row 167 — piece 3j-i) — WhatsApp inbox.
