// ─── APPOINTMENTS & QUEUE ───────────────────────────────

model Appointment {
  id                    String            @id @default(uuid())
  patientId             String
  doctorId              String
  date                  DateTime          @db.Date
  slotStart             String? // HH:MM — null for walk-ins / CALLING-mode
  slotEnd               String?
  // tokenNumber: legacy TOKEN-mode bookings carry a sequential number.
  // CALLING / SLOT mode bookings leave this null (Pearl §2.1.2).
  // Postgres treats multiple NULLs as distinct so the existing
  // @@unique [doctorId, date, tokenNumber] still enforces uniqueness
  // among TOKEN-mode rows without blocking null-token rows.
  tokenNumber           Int?
  // arrivalSeq: CALLING-mode arrival counter, scoped per doctor + date.
  // Null for TOKEN / SLOT mode bookings.
  arrivalSeq            Int?
  type                  AppointmentType
  status                AppointmentStatus @default(BOOKED)
  priority              Priority          @default(NORMAL)
  notes                 String?
  checkInAt             DateTime?
  calledAt              DateTime?
  consultationStartedAt DateTime?
  consultationEndedAt   DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Group appointments (Apr 2026) — therapy / training sessions
  groupId String?

  // Coordinated multi-doctor visit (Apr 2026)
  coordinatedVisitId String?

  // LWBS (Left Without Being Seen) - reuses NO_SHOW status (Apr 2026)
  lwbsReason String?

  // Pearl §3.1 — cancel / reschedule / no-show reasons (2026-05-29). All
  // nullable: a row only carries the reason for the action that fired.
  // The Zod schemas REQUIRE reasons on the corresponding status / route
  // call so we never lose the audit trail at the boundary, but the
  // columns stay nullable to keep legacy rows valid post-migration.
  cancellationReason String?
  rescheduleReason   String?
  noShowReason       String?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Pearl ERP Stage 1 §7.2 — piece 2a (branchScopedPrisma POC, 2026-05-21).
  // Optional + nullable on purpose so legacy rows and requests without a
  // branch context keep working unchanged. The branchScopedPrisma extension
  // (packages/db/src/branch-prisma.ts) auto-stamps this column on create
  // when `runWithBranch(branchId, ...)` is in scope and auto-filters reads
  // when no explicit `where.branchId` is supplied.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  patient          Patient           @relation(fields: [patientId], references: [id])
  doctor           Doctor            @relation(fields: [doctorId], references: [id])
  vitals           Vitals?
  consultation     Consultation?
  prescription     Prescription?
  invoice          Invoice?
  coordinatedVisit CoordinatedVisit? @relation("CoordinatedAppointments", fields: [coordinatedVisitId], references: [id])
  aiTriageSession  AITriageSession?
  aiScribeSession  AIScribeSession?

  // ── Back-relation merged from .prisma-models-patient-tools.md ────────
  previsitChecklist PrevisitChecklist?

  // ── PRD closure (2026-04-24) ─────────────────────────────
  feedbacks PatientFeedback[]

  // Pearl §2.1.7 — threaded remarks per appointment.
  remarks AppointmentRemark[] @relation("AppointmentRemarks")

  @@unique([doctorId, date, tokenNumber])
  // Pearl §2.1.2 — SLOT-mode no-double-booking. Postgres allows
  // multiple NULL slotStart values so this does not regress walk-ins
  // or CALLING/TOKEN-mode rows.
  @@unique([doctorId, date, slotStart])
  @@index([doctorId, date])
  @@index([patientId])
  @@index([date, status])
  @@index([groupId])
  @@index([coordinatedVisitId])
  @@index([tenantId])
  @@index([branchId])
  @@map("appointments")
}

// Pearl §2.1.7 — threaded, visibility-scoped, pinnable remarks attached
// to an Appointment. Replaces the single `Appointment.notes` string with
// a multi-author conversation that Reception / Doctor / Nurse can each
// contribute to with role-controlled visibility.
//
// Visibility model:
//   ALL_STAFF       — every non-PATIENT role on the same tenant
//   DOCTOR_ONLY     — DOCTOR + ADMIN
//   RECEPTION_ONLY  — RECEPTION + ADMIN
//   PRIVATE         — author only (+ ADMIN)
// PATIENT role never sees remarks (clinical notes are staff-internal).
//
// Threading: optional `parentRemarkId` lets a remark reply to an earlier
// one. Replies inherit the parent's visibility at write time (enforced
// in the route handler) so a PRIVATE thread can't leak via a reply.
//
// Pinning: any DOCTOR/ADMIN can pin the most important remark to the
// top of the list (pinned-first, then desc by createdAt).
enum AppointmentRemarkVisibility {
  ALL_STAFF
  DOCTOR_ONLY
  RECEPTION_ONLY
  PRIVATE
  // Pearl SOW §2.1.7 — patient-facing scopes added 2026-05-29.
  // PATIENT_VISIBLE: readable by the appointment's patient AND all staff
  //   (the patient's own portal surface for clinician messages back to
  //   them). Patients can author remarks at this level only.
  // PUBLIC: readable by anyone authenticated who can see the appointment
  //   (staff + the appointment's patient + family members on a future
  //   delegated-access list). Staff-only authorship for now — patients
  //   cannot post PUBLIC remarks since they'd otherwise have a write
  //   path into a level visible to delegated viewers they don't control.
  PATIENT_VISIBLE
  PUBLIC
}

model AppointmentRemark {
  id             String                      @id @default(uuid())
  appointmentId  String
  authorUserId   String
  parentRemarkId String?
  body           String
  visibility     AppointmentRemarkVisibility @default(ALL_STAFF)
  isPinned       Boolean                     @default(false)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  editedAt       DateTime?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  appointment Appointment         @relation("AppointmentRemarks", fields: [appointmentId], references: [id], onDelete: Cascade)
  author      User                @relation("AppointmentRemarkAuthor", fields: [authorUserId], references: [id])
  parent      AppointmentRemark?  @relation("AppointmentRemarkThread", fields: [parentRemarkId], references: [id], onDelete: SetNull)
  replies     AppointmentRemark[] @relation("AppointmentRemarkThread")

  @@index([appointmentId])
  @@index([authorUserId])
  @@index([parentRemarkId])
  @@index([tenantId])
  @@map("appointment_remarks")
}

// ─── PATIENT FAMILY LINKS (bidirectional) ───────────────
model PatientFamilyLink {
  id               String   @id @default(uuid())
  patientId        String
  relatedPatientId String
  relationship     String // PARENT, CHILD, SPOUSE, SIBLING, GUARDIAN
  createdAt        DateTime @default(now())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patient        Patient @relation("PatientPrimary", fields: [patientId], references: [id], onDelete: Cascade)
  relatedPatient Patient @relation("PatientRelated", fields: [relatedPatientId], references: [id], onDelete: Cascade)

  @@unique([patientId, relatedPatientId])
  @@index([patientId])
  @@index([relatedPatientId])
  @@index([tenantId])
  @@map("patient_family_links")
}

// ─── OPD — VITALS & CONSULTATION ────────────────────────

model Vitals {
  id                     String   @id @default(uuid())
  appointmentId          String   @unique
  patientId              String
  nurseId                String
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  temperature            Float?
  temperatureUnit        String?  @default("F") // "F" or "C"
  weight                 Float?
  height                 Float?
  pulseRate              Int?
  spO2                   Int?
  painScale              Int? // 0-10
  respiratoryRate        Int?
  bmi                    Float?
  isAbnormal             Boolean  @default(false)
  abnormalFlags          String? // comma-separated flags e.g. "HIGH_BP,LOW_SPO2"
  notes                  String?
  recordedAt             DateTime @default(now())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  patient     Patient     @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([tenantId])
  @@map("vitals")
}

model Consultation {
  id            String    @id @default(uuid())
  appointmentId String    @unique
  doctorId      String
  notes         String?
  findings      String?
  // Pearl ERP §2.1.3 — SOAP-tabbed manual consult canvas. Each tab
  // stores free-text per the SOAP convention (Subjective / Objective /
  // Assessment / Plan). Separate columns (not a single JSON blob) so
  // analytics can filter / search per-tab without parsing JSON.
  subjective    String?
  objective     String?
  assessment    String?
  plan          String?
  // ICD-10 + SNOMED CT diagnosis coding (Pearl §2.1.3). Stored as
  // JSON arrays of `{ code, description }` objects so the structured
  // form can show full code+label pairs without an extra join.
  icd10Codes    Json?
  snomedCodes   Json?
  // Lifecycle: DRAFT while the doctor is still editing; SIGNED once
  // they explicitly finalize. Used by reporting and by the visit
  // history right-rail to filter only signed visits.
  status        String    @default("DRAFT") // DRAFT | SIGNED
  signedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  doctor      Doctor      @relation(fields: [doctorId], references: [id])

  // ── Back-relation merged from .prisma-models-ops-quality.md ──────────
  docQaReport DocQAReport?

  @@index([tenantId])
  @@map("consultations")
}

// ─── PRESCRIPTIONS ──────────────────────────────────────

model Prescription {
  id              String             @id @default(uuid())
  appointmentId   String             @unique
  patientId       String
  doctorId        String
  diagnosis       String
  advice          String?
  followUpDate    DateTime?          @db.Date
  signatureUrl    String?
  pdfUrl          String?
  printed         Boolean            @default(false)
  printedAt       DateTime?
  sharedVia       String? // WHATSAPP,EMAIL,SMS (comma-separated)
  sharedAt        DateTime?
  copiedFromId    String?
  // Lifecycle state (2026-05-03 migration). Existing rows backfilled to
  // PENDING. DISPENSED set by pharmacist on full dispense; REJECTED for
  // pharmacist rejection with a reason; CANCELLED for doctor revocation.
  status          PrescriptionStatus @default(PENDING)
  rejectionReason String?
  rejectedAt      DateTime?
  rejectedBy      String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  appointment       Appointment                @relation(fields: [appointmentId], references: [id])
  patient           Patient                    @relation(fields: [patientId], references: [id])
  doctor            Doctor                     @relation(fields: [doctorId], references: [id])
  rejectedByUser    User?                      @relation("PrescriptionRejectedBy", fields: [rejectedBy], references: [id], onDelete: SetNull)
  items             PrescriptionItem[]
  controlledEntries ControlledSubstanceEntry[]

  // ── PRD closure (2026-04-24) ─────────────────────────────
  medicationIncidents MedicationIncident[]

  @@index([patientId])
  @@index([tenantId])
  @@index([status])
  @@index([rejectedBy])
  @@map("prescriptions")
}

enum PrescriptionStatus {
  // Pearl §4.3 (gap row 104, 2026-05-22): DISPENSING + READY split lets the
  // pharmacy Kanban model the in-flight work that used to be hidden behind
  // PENDING — "I picked up the script and started filling it" vs "the
  // medicine is bagged on the counter waiting for the patient to collect".
  // Enum-value order is the column order in the Kanban board (left → right):
  // PENDING (New) → DISPENSING → READY → DISPENSED. Terminal: REJECTED,
  // CANCELLED. Forward-only state machine guarded in
  // `routes/pharmacy.ts:PATCH /prescriptions/:id/status` (READY→DISPENSING
  // step-back is allowed for re-mix).
  PENDING
  DISPENSING
  READY
  DISPENSED
  REJECTED
  CANCELLED
}

model PrescriptionItem {
  id             String  @id @default(uuid())
  tenantId       String?
  tenant         Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prescriptionId String
  // Issue #898 (2026-05-19): structured FK to the Medicine master so the
  // allergy/interaction engine, pharmacy dispense (FEFO + stock deduction),
  // and refill quotas can link Rx items to a real SKU. Nullable for now —
  // 48 historical rows on STAGING use free-text `medicineName` only, and the
  // backfill migration name-matches what it can but leaves the rest NULL
  // rather than guessing. `medicineName` stays as the denormalized display
  // name (back-compat + historical snapshot so a master rename doesn't
  // rewrite history). Follow-up: flip to NOT NULL once writers are converted
  // + UI autocomplete ships.
  medicineId     String?
  medicineName   String
  dosage         String
  frequency      String
  duration       String
  instructions   String?
  refills        Int     @default(0)
  refillsUsed    Int     @default(0)

  // Per-medicine pharmacy Kanban status. The board models EACH line item as
  // its own card moving PENDING (New) → DISPENSING → READY → DISPENSED
  // independently — a script with mixed stock can have some lines dispensed
  // while out-of-stock lines stay in New. Reuses the prescription-level enum.
  kanbanStatus PrescriptionStatus @default(PENDING)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine?    @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  @@index([medicineId])
  @@index([kanbanStatus])
  @@index([tenantId])
  @@map("prescription_items")
}

