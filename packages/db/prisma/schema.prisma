  // invite row — raw token only leaves the server in the outbound email.
  userInvites UserInvite[]

  // Pearl §8.3 (gap row 214 closure 2026-05-24) — per-tenant daily usage
  // metering. One row per tenant per day; the daily 01:00 collector
  // (`services/tenant-usage-collector.ts`) groups Notifications by
  // channel for the prior UTC day and upserts the counts. Powers
  // operator billing visibility (plan-quota vs actual usage); the
  // super-admin UI consumer ships as a separate piece.
  tenantUsageDaily TenantUsageDaily[]

  // Pearl §8.3 (gap rows 215-218 closure piece 3a 2026-05-24) — platform
  // billing surface. One TenantSubscription per tenant (the plan the
  // tenant is subscribed to + trial/active/past_due/suspended state);
  // many PlatformInvoice rows (one per month per tenant, generated by
  // the monthly cron in piece 3b).
  tenantSubscription TenantSubscription?
  platformInvoices   PlatformInvoice[]
  usageEvents        UsageEvent[]
  requestMetrics     RequestMetric[]

  // ── tenantId added to formerly-unscoped tables (2026-06-11 —
  //    migration 20260611000002_add_tenant_id_remaining_tables) ──────────
  medicines                Medicine[]
  labTests                 LabTest[]
  labTestReferenceRanges   LabTestReferenceRange[]
  invoiceItems             InvoiceItem[]
  labOrderItems            LabOrderItem[]
  prescriptionItems        PrescriptionItem[]
  purchaseOrderItems       PurchaseOrderItem[]
  grnItems                 GrnItem[]
  claimDocuments           ClaimDocument[]
  claimStatusEvents        ClaimStatusEvent[]
  platformInvoiceLineItems PlatformInvoiceLineItem[]
  supportTicketMessages    SupportTicketMessage[]
  refreshTokens            RefreshToken[]
  passwordResetCodes       PasswordResetCode[]
  twoFactorTempTokens      TwoFactorTempToken[]
  notificationPreferences  NotificationPreference[]
  userDashboardPreferences UserDashboardPreference[]

  @@map("tenants")
}

// Pearl ERP Stage 1 §8.3 (gap row 214 closure 2026-05-24) — per-tenant
// daily usage counters. The collector cron (apps/api/src/services/
// tenant-usage-collector.ts) runs once daily at ~01:00 host time, groups
// the prior UTC day's `notifications` rows by `channel` per `tenantId`
// (filter: deliveryStatus in SENT/DELIVERED/READ), and upserts one row
// per (tenantId, date) pair. Super-admins can later read these rows for
// plan-vs-usage dashboards / billing line items.
//
// Idempotent by construction — the `@@unique([tenantId, date])` lets the
// collector re-run for the same date without duplicating rows.
model TenantUsageDaily {
  id            String   @id @default(uuid())
  tenantId      String
  date          DateTime @db.Date
  whatsappCount Int      @default(0)
  smsCount      Int      @default(0)
  emailCount    Int      @default(0)
  pushCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId, date])
  @@map("tenant_usage_daily")
}

// Pearl ERP Stage 1 §8.3 (gap rows 215-218 closure piece 3a 2026-05-24) —
// platform-billing subscription. One row per tenant capturing the plan
// the tenant pays the platform operator (Onviqa) for + the lifecycle
// state machine (trial → active → past_due → suspended / cancelled).
//
// - `plan` picks one of the three Plan tiers (STARTER / GROWTH /
//   ENTERPRISE); the resolved feature-flag set is materialised onto
//   `Tenant.featureFlags` whenever the plan changes (writer lives in
//   piece 3c).
// - `customPriceMonthlyInPaise` lets the sales team override the plan
//   base price for bespoke Enterprise deals without forking the Plan
//   enum or seeding a separate price table.
// - `razorpaySubscriptionId` is populated once auto-debit is enabled
//   (Razorpay Subscriptions API; piece 3c).
// - `pastDueSince` stamps the start of the 7-day read-only grace
//   window so the daily transition cron can flip past_due → suspended
//   at `pastDueSince + 7d`.
//
// Pieces 3b (monthly invoice generation cron) and 3c (Razorpay webhook
// + proration logic + grace-period state-machine transitions) ship
// separately and read/write rows on this table + PlatformInvoice below.
model TenantSubscription {
  id                        String             @id @default(uuid())
  tenantId                  String             @unique
  tenant                    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                      String // PlatformPlan.key
  status                    SubscriptionStatus @default(trial)
  trialEndsAt               DateTime?
  currentPeriodStart        DateTime
  currentPeriodEnd          DateTime
  customPriceMonthlyInPaise Int? // overrides plan base price for Enterprise bespoke deals
  razorpaySubscriptionId    String? // populated when auto-debit is enabled
  pastDueSince              DateTime? // set when status flips to past_due
  cancelledAt               DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  invoices                  PlatformInvoice[]

  @@map("tenant_subscriptions")
}

// Pearl ERP Stage 1 §8.3 (gap rows 215-218 closure piece 3a 2026-05-24) —
// platform → tenant invoice (Onviqa → hospital, monthly). Distinct from
// the existing patient-facing `Invoice` model which is hospital → patient.
//
// - `invoiceNumber` follows the `PI-YYYYMM-NNNN` convention (PI =
//   Platform Invoice; monotonic per-month sequence across all tenants),
//   distinguishing these from the hospital-side `INV-*` series.
// - GST is persisted per-invoice (CGST / SGST for same-state tenants;
//   IGST for cross-state). Line-item HSN/SAC defaults to `998314`
//   (Information Technology Software Services) and may be overridden
//   per line for non-SaaS charges.
// - `paidByUserId` records the PLATFORM_OPERATOR / PLATFORM_BILLING_
//   OPERATOR User who marked the invoice paid. No FK constraint to
//   `User` yet (the operator roles ship in a separate piece and the
//   relation can be added then without a destructive migration).
// - `onDelete: Restrict` on both FKs — we never want to lose financial
//   history through cascade deletion.
model PlatformInvoice {
  id               String                    @id @default(uuid())
  invoiceNumber    String                    @unique // format: PI-YYYYMM-NNNN
  tenantId         String
  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscriptionId   String
  subscription     TenantSubscription        @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  periodStart      DateTime
  periodEnd        DateTime
  subtotalInPaise  Int // line items sum before tax
  cgstInPaise      Int                       @default(0)
  sgstInPaise      Int                       @default(0)
  igstInPaise      Int                       @default(0)
  totalInPaise     Int // subtotal + GST
  status           String                    @default("DRAFT") // DRAFT, ISSUED, PAID, VOID
  issuedAt         DateTime?
  paidAt           DateTime?
  paidByUserId     String? // FK-by-convention to User; cascade rules + relation deferred to operator-role piece
  paymentReference String? // bank ref / Razorpay payment id
  hsnSacCode       String                    @default("998314") // SAC for SaaS
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  lineItems        PlatformInvoiceLineItem[]

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@index([periodStart])
  @@map("platform_invoices")
}

// Pearl ERP Stage 1 §8.3 (gap rows 215-218 closure piece 3a 2026-05-24) —
// PlatformInvoice line items. Per-line CGST/SGST/IGST rates persisted
// (rather than computed) so re-pricing the Plan tiers later does not
// retroactively re-shape historical invoices. `amountInPaise` equals
// `unitPriceInPaise * quantity` and is the pre-tax line subtotal.
model PlatformInvoiceLineItem {
  id               String          @id @default(uuid())
  tenantId         String?
  tenant           Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId        String
  invoice          PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description      String
  unitPriceInPaise Int
  quantity         Int             @default(1)
  amountInPaise    Int // unitPrice * quantity
  hsnSacCode       String          @default("998314")
  cgstRate         Float           @default(0) // e.g. 9.0 for 9%
  sgstRate         Float           @default(0)
  igstRate         Float           @default(0)
  createdAt        DateTime        @default(now())

  @@index([invoiceId])
  @@index([tenantId])
  @@map("platform_invoice_line_items")
}

// Pearl ERP Stage 1 §8.3 piece 3e (2026-05-28) — usage-based billing.
//
// Per-tenant counter rows for billable platform actions:
//   - WHATSAPP_SENT   — outbound WhatsApp message (template or session)
//   - SMS_SENT        — outbound SMS via the messaging service
//   - LLM_TOKENS      — Anthropic / OpenAI inference tokens (combined
//                       input + output); `quantity` is the token count
//                       and `meta.model` records which model the
//                       inference ran against
//   - ABDM_MESSAGE    — ABDM-bound message (consent push, FHIR fetch, …)
//
// One row per event keeps the source-of-truth granular for audit (the
// monthly cron aggregates these into a single line item per usage kind).
// `meta` is a free-form JSON column for kind-specific context (the LLM
// model, the WhatsApp template id, etc.) so the schema doesn't need a
// new column for every meter we add later.
//
// Indexed on (tenantId, kind, createdAt) so the monthly aggregator can
// run `groupBy({ tenantId, kind, where: { createdAt: { gte, lt } } })`
// cheaply at month-end.
model UsageEvent {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      String // WHATSAPP_SENT | SMS_SENT | LLM_TOKENS | ABDM_MESSAGE
  quantity  Int      @default(1) // 1 per event for messages; token count for LLM
  meta      Json?
  createdAt DateTime @default(now())

  @@index([tenantId, kind, createdAt])
  @@map("usage_events")
}

// Pearl ERP Stage 1 §7.2 + §8.1 (gap item #2 — pieces 1 + 2a of 3) — branch model.
//
// A tenant (hospital) can run from multiple branches. Pearl explicitly
// requires branch-aware scoping on every transactional table; this
// model is the foundation. Piece 2a (2026-05-21) wired the first
// transactional `branchId` (Appointment) into a `branchScopedPrisma`
// extension (packages/db/src/branch-prisma.ts). Piece 2b (Invoice /
// Doctor / Patient + backfill) and piece 3 (branch picker UI + report
// filters) ship later.
//
// Invariant: exactly one Branch per tenant must have isDefault=true.
// Postgres has no first-class partial unique index for "one row per
// (tenantId) where isDefault=true" that Prisma can declare in schema,
// so this is API-enforced (see apps/api/src/routes/branches.ts —
// POST auto-defaults the first branch, PATCH that sets isDefault=true
// atomically unsets it on the previous default, DELETE refuses to
// soft-delete the default).
model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String? // short label like "MAIN", "JKR" — optional
  address   String?
  city      String?
  state     String?
  pincode   String?
  phone     String?
  email     String?
  gstin     String?
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Pearl ERP Stage 1 §7.2 — piece 2a (branchScopedPrisma POC, 2026-05-21).
  // First transactional table wired into the branch-scoped Prisma extension.
  // Piece 2b (2026-05-21 follow-up) extended scoping to Invoice + Doctor +
  // Patient via the back-relations below.
  appointments Appointment[]
  invoices     Invoice[]     @relation("InvoiceBranch")
  doctors      Doctor[]      @relation("DoctorBranch")
  patients     Patient[]     @relation("PatientBranch")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, active])
  @@map("branches")
}

// Pearl ERP Stage 1 §5.1 (gap item #4 — piece 1 of 4) — Campaign engine enums.
// CampaignKind: BROADCAST is a one-off blast (the multi-stage cousin of
// NotificationBroadcast); DRIP is a time-spaced sequence; TRIGGER fires on
// events (birthday, anniversary, etc.); COHORT_REMINDER nudges a saved
// audience on a cadence. CampaignChannel mirrors NotificationChannel for
// future cross-wiring (piece 2 dispatcher will substitute NotificationChannel
// when routing through the existing services/channels/ adapters) but is
// kept distinct so the Campaign surface can evolve independently. SendStatus
// is per-recipient and is written by the dispatcher (piece 2).
enum CampaignChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum CampaignKind {
  BROADCAST
  DRIP
  TRIGGER
  COHORT_REMINDER
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum SendStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  BOUNCED
  FAILED
  SUPPRESSED
  UNSUBSCRIBED
}

// Pearl ERP Stage 1 §3.3 (gap item #3) — CRM lead pipeline.
// Six-stage state machine: NEW → QUALIFIED → ENGAGED → BOOKED →
// CONVERTED → LOST. Multi-source intake (WEB, WALK_IN, PHONE,
// WHATSAPP, REFERRAL, OTHER) with an activity log per lead and
// an optional `convertedPatientId` link when the lead becomes a
// real patient.
//
// Distinct from MarketingEnquiry (the flat marketing-site contact-
// form row). A MarketingEnquiry can promote to a Lead via
// POST /api/v1/leads with marketingEnquiryId set.
enum LeadStatus {
  NEW
  QUALIFIED
  ENGAGED
  BOOKED
  CONVERTED
  LOST
}

enum LeadSource {
  WEB
  WALK_IN
  PHONE
  WHATSAPP
  REFERRAL
  OTHER
}

// Pearl ERP Stage 1 §2.1.1 — attribution tag for new patient registrations.
// Mirrors LeadSource but adds PWA for the patient-self-registration path
// (Pearl gap #5 piece 2/4) once that flow creates Patient rows. WALK_IN is
// the default — legacy rows pre-date the PWA + web-panel registration
// surfaces, and the staff `POST /api/v1/patients` endpoint defaults to WEB
// when the request body omits a source.
enum PatientSource {
  WEB
  PWA
  WALK_IN
  REFERRAL
  WHATSAPP
  PHONE
  OTHER
}

enum LeadActivityType {
  STATUS_CHANGE
  NOTE
  CALL
  MESSAGE
  EMAIL
  WHATSAPP_OUTBOUND
  DOCTOR_ALLOCATION
  CONVERSION
}

model Lead {
  id                 String     @id @default(uuid())
  name               String
  phone              String?
  email              String?
  source             LeadSource @default(WEB)
  status             LeadStatus @default(NEW)
  // Optional links — let lead "want a derm consult" or "from Dr. X's
  // referral" carry the soft preference into the conversion flow.
  preferredDoctorId  String?
  assignedToUserId   String?
  // Free-text scratchpad — chief complaint, notes from the intake call.
  notes              String?
  // Lifecycle attribution. convertedPatientId is set by the CONVERT
  // endpoint and is the link that distinguishes a CONVERTED lead from
  // a LOST one (some hospitals re-engage LOST leads later).
  convertedAt        DateTime?
  convertedPatientId String?
  // Optional promotion path — a MarketingEnquiry row can be promoted
  // into a Lead; we keep the back-ref so duplicate-promotion is easy
  // to detect (findFirst on this column).
  marketingEnquiryId String?    @unique

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  preferredDoctor  Doctor?           @relation("LeadPreferredDoctor", fields: [preferredDoctorId], references: [id], onDelete: SetNull)
  assignedToUser   User?             @relation("LeadAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  convertedPatient Patient?          @relation("LeadConvertedPatient", fields: [convertedPatientId], references: [id], onDelete: SetNull)
  marketingEnquiry MarketingEnquiry? @relation(fields: [marketingEnquiryId], references: [id], onDelete: SetNull)
  activities       LeadActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([source])
  @@index([assignedToUserId])
  @@index([preferredDoctorId])
  @@map("leads")
}

model LeadActivity {
  id           String           @id @default(uuid())
  leadId       String
  authorUserId String?
  type         LeadActivityType
  // Optional structured payload (e.g. {fromStatus: "NEW", toStatus: "QUALIFIED"}
  // for STATUS_CHANGE; {channel: "WHATSAPP", body: "..."} for outbound).
  data         Json?
  // Free-text summary visible in the activity stream.
  body         String?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorUser User? @relation("LeadActivityAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([authorUserId])
  @@index([type])
  @@index([tenantId])
  @@map("lead_activities")
}

// ─── CARE COHORTS ───────────────────────────────────────
// Named groups of patients ("Diabetic patients on insulin", "ANC 3rd
// trimester") so operational workflows — outbound calls, batched
// reminders, follow-up campaigns, reporting — can target the group
// instead of re-running a filter every time. The join table is
// explicit (CohortMember) rather than Prisma's implicit many-to-many
// so we can add per-membership metadata later (joinedReason, addedBy)
// without a destructive migration.

model Cohort {
  id          String  @id @default(uuid())
  name        String
  description String?

  // Soft-delete: keep historical references intact (campaign rows that
  // targeted this cohort, audit log entries) even after the cohort is
  // retired from the active list. Default null = active.
  archivedAt DateTime?

  // Optional attribution. Nullable so legacy seed rows + system-created
  // cohorts don't need a creator. SetNull on user deletion so a departed
  // staff member's cohorts aren't orphan-deleted.
  createdByUserId String?
  createdByUser   User?   @relation("CohortCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  members CohortMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([createdByUserId])
  @@index([archivedAt])
  @@map("cohorts")
}

model CohortMember {
  id        String @id @default(uuid())
  cohortId  String
  patientId String

  // Optional free-text annotation visible on the member row (e.g.
  // "HbA1c > 8.0 — enrolled 2026-05-12 by Dr. Rao"). Keeps the join
  // table useful for clinical context without overloading the cohort
  // description itself.
  note String?

  // Attribution + audit. addedByUserId is nullable for system-added
  // members (a future filter-rule auto-populator). SetNull on user
  // deletion so the row survives staff turnover.
  addedByUserId String?
  addedByUser   User?   @relation("CohortMemberAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cohort  Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  patient Patient @relation("PatientCohortMemberships", fields: [patientId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@unique([cohortId, patientId])
  @@index([cohortId])
  @@index([patientId])
  @@index([tenantId])
  @@map("cohort_members")
}

// ─── USERS & AUTH ───────────────────────────────────────

model User {
  id                   String    @id @default(uuid())
  // #891 (May 2026): nullable. Previously NOT NULL, which forced the
  // patients-registration write site to fabricate a
  // `noemail+<MR>@medcore.invalid` placeholder when reception didn't
  // capture an email — 183 such rows leaked into staging, broke the
  // EMAIL notification channel (every send bounced), polluted Razorpay
  // receipts, and made password-reset enumeration impossible. Schema-
  // side null is now the source of truth: every reader (login,
  // notifications, Razorpay, password-reset) sees `null` and skips
  // gracefully instead of relying on a sentinel-detection guard in N
  // services. Unique constraint still applies (Postgres treats multiple
  // NULLs as distinct, so unique + nullable composes correctly).
  email                String?   @unique
  phone                String
  name                 String
  passwordHash         String
  role                 Role
  isActive             Boolean   @default(true)
  // Pearl §8.2 — root super-admin flag. Exactly one User row is
  // expected to carry true (the seed `superadmin@medcore.local`).
  // Only this user can deactivate / reactivate OTHER super-admins;
  // peer super-admins can still manage tenant ADMINs + billing as
  // normal, this gate is scoped to mutations against other root-
  // level operators so a compromised peer can't lock out root.
  isMainSuperAdmin     Boolean   @default(false)
  photoUrl             String?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes Json?
  preferredLanguage    String?
  defaultLandingPage   String?
  pushToken            String?
  pushPlatform         String?
  pushTokenUpdatedAt   DateTime?
  // Stamped on every successful login (password + 2FA paths). The super-admin
  // Tenants list reads MAX(lastLoginAt) per tenant for its "Last login" column
  // — reliable, unlike the old audit-log derivation (audit rows get archived
  // and are tenant-scoped).
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  doctor                    Doctor?
  patient                   Patient?
  notifications             Notification[]
  notificationPreferences   NotificationPreference[]
  refreshTokens             RefreshToken[]
  medicationAdministrations MedicationAdministration[]
  nurseRounds               NurseRound[]
  stockMovements            StockMovement[]
  uploadedDocuments         PatientDocument[]
  recordUploads             RecordUpload[]             @relation("RecordUploadAuthor")
  shifts                    StaffShift[]
  leaveRequests             LeaveRequest[]             @relation("LeaveOwner")
  approvedLeaves            LeaveRequest[]             @relation("LeaveApprover")
  recordedExpenses          Expense[]
  sentMessages              ChatMessage[]              @relation("MessageSender")
  chatParticipants          ChatParticipant[]
  assetAssignments          AssetAssignment[]
  maintenanceLogs           AssetMaintenance[]
  controlledDispenses       ControlledSubstanceEntry[]
  labQcEntries              LabQCEntry[]
  certifications            StaffCertification[]
  overtimeRecords           OvertimeRecord[]
  passwordResetCodes        PasswordResetCode[]
  twoFactorTempTokens       TwoFactorTempToken[]

  // ── Back-relations merged from .prisma-models-ops-forecast.md ────────
  proposalsCreated StaffRosterProposal[] @relation("RosterProposalCreator")
  proposalsApplied StaffRosterProposal[] @relation("RosterProposalApplier")

  // ── PRD closure (2026-04-24) ─────────────────────────────
  medicationIncidentsReported MedicationIncident[] @relation("MedicationIncidentReporter")

  // ── 2026-05-03 migration (witness signature + Rx status) ─────────────
  controlledSubstanceWitnessing ControlledSubstanceEntry[] @relation("ControlledSubstanceWitness")
  prescriptionsRejected         Prescription[]             @relation("PrescriptionRejectedBy")

  // ── Issue #718 (calendar events created by admins) ───────────────────
  calendarEventsCreated CalendarEvent[]

  // Pearl §2.1.7 — appointment remarks this user has authored.
  appointmentRemarks AppointmentRemark[] @relation("AppointmentRemarkAuthor")

  // Pearl §3.3 (gap item #3) — leads this user owns + activities they've logged.
  leadsAssigned  Lead[]         @relation("LeadAssignedTo")
  leadActivities LeadActivity[] @relation("LeadActivityAuthor")

  // SOW row M4 — cohorts this user created + memberships they've added.
  cohortsCreated     Cohort[]       @relation("CohortCreatedBy")
  cohortMembersAdded CohortMember[] @relation("CohortMemberAddedBy")

  // Pearl §5.1 (gap item #4 — piece 1 of 4) — campaigns this user created.
  // Named relation so later pieces (A/B variant assignment, etc.) can add
  // distinct relations to User without colliding.
  campaignsCreated Campaign[] @relation("CampaignCreator")

  // Pearl §8.5 (gap row 223 closure 2026-05-23) — Pearl-operator support
  // tickets. Three distinct relations:
  //   - opener  : the tenant-ADMIN (or super-admin) who filed the ticket.
  //   - assignee: the super-admin currently triaging it.
  //   - messages: replies authored on either side of the thread.
  supportTicketsOpened   SupportTicket[]        @relation("SupportTicketOpener")
  supportTicketsAssigned SupportTicket[]        @relation("SupportTicketAssignee")
  supportTicketMessages  SupportTicketMessage[]

  // Pearl §8.2 (gap row 213 closure 2026-05-23) — staff email-invite flow.
  //   - userInvitesSent     : invites this ADMIN issued.
  //   - userInvitesAccepted : invites this user materialised by accepting
  //     (back-pointer to the originating UserInvite row for audit trace).
  userInvitesSent     UserInvite[] @relation("UserInviteInviter")
  userInvitesAccepted UserInvite[] @relation("UserInviteAcceptedUser")

  // Pearl §S2.2 row 92 (closure 2026-05-25) — implants this user registered.
  implantsRegistered Implant[] @relation("ImplantRegisteredBy")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("refresh_tokens")
}

model PasswordResetCode {
  id        String    @id @default(uuid())
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tenantId])
  @@map("password_reset_codes")
}

model TwoFactorTempToken {
  id        String    @id @default(uuid())
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tenantId])
  @@map("two_factor_temp_tokens")
}

// ─── PATIENT PHONE-OTP LOGIN (Pearl §5.3 / §6.1 — gap #5 piece 2 of 4) ────
// One row per OTP challenge issued via POST /api/v1/patient-auth/otp-request.
// The plaintext code is NEVER stored — only its bcrypt hash. Records persist
// past `expiresAt` for short-term auditability; the cleanup job (future) can
// prune by `expiresAt < now() - INTERVAL '1 day'`.
//
// `consumed` flips true on the first successful verify so the same challenge
// cannot be replayed. `attempts` counts verify failures; the route returns
// 429 once it crosses 5 (lockout-per-challenge, NOT per-phone — the per-phone
// throttle is handled by the request-side rate limiter).
//
// `tenantId` is nullable: the lookup of User by phone occurs without a
// tenant scope (the caller hasn't authenticated yet), so we cannot pre-pin
// the challenge to a tenant. Verify mints the JWT with the resolved
// `user.tenantId` on success.
model PatientOtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  otpHash   String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  tenantId  String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
  @@map("patient_otp_challenges")
}

// ─── DOCTOR ─────────────────────────────────────────────

model Doctor {
  id              String   @id @default(uuid())
  userId          String   @unique
  specialization  String?
  qualification   String?
