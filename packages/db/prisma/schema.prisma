  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  createdBy   String
  createdAt   DateTime @default(now())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

